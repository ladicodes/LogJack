# Copy to frontend/.env.local for local overrides. Vite inlines VITE_* values at BUILD time,
# so changing them on Vercel requires a redeploy.

# Backend origin used by the browser. Leave EMPTY for local development: the Vite dev server
# proxies /api to http://127.0.0.1:8000, and FastAPI serves the built app same-origin.
# Production (Vercel): https://logjack-1.onrender.com
# A trailing slash or a trailing /api are both fine; they are normalised away.
VITE_API_BASE_URL=
