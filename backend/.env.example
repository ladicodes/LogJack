# Copy to backend/.env and fill in what you need. Every variable is optional:
# with nothing set, LogJack runs fully offline using the mock provider.

# ---------------------------------------------------------------- storage
# LOGJACK_DB_PATH=./data/logjack.db

# ---------------------------------------------------------------- OpenAI-compatible APIs
# Works with OpenAI and any server exposing /v1/chat/completions (vLLM, LM Studio, gateways).
LOGJACK_OPENAI_API_KEY=
LOGJACK_OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated list shown in the UI as openai:<model>
LOGJACK_OPENAI_MODELS=gpt-4o-mini

# ---------------------------------------------------------------- Anthropic Messages API
LOGJACK_ANTHROPIC_API_KEY=
LOGJACK_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5

# ---------------------------------------------------------------- Ollama (local models)
LOGJACK_OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to auto-discover pulled models via /api/tags
LOGJACK_OLLAMA_MODELS=

# ---------------------------------------------------------------- generation
LOGJACK_TEMPERATURE=0.0
LOGJACK_MAX_TOKENS=800
LOGJACK_REQUEST_TIMEOUT_S=60

# ---------------------------------------------------------------- mock provider / canary
LOGJACK_MOCK_LATENCY_MS=2
# Salt used to derive per-case canary tokens for the combined defense.
LOGJACK_CANARY_SALT=change-me-locally

# ---------------------------------------------------------------- CORS
# Exact browser origins allowed to call the API (comma-separated). The defaults cover local dev
# and https://log-jack.vercel.app. Add a custom domain here if you attach one on Vercel.
# LOGJACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://log-jack.vercel.app
# Regex for the Vercel project's preview/branch hostnames. Set empty to disable.
# LOGJACK_CORS_ORIGIN_REGEX=https://log-jack(-[a-z0-9-]+)?\.vercel\.app

# Serve the built frontend (frontend/dist) from the API server at http://localhost:8000
LOGJACK_SERVE_FRONTEND=true
